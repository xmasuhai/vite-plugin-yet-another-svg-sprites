{
  "name": "vite-plugin-yet-another-svg-sprites",
  "version": "0.1.0",
  "private": false,
  "description": "A framework-agnostic Vite plugin for SVG sprites",
  "repository": "https://github.com/xmasuhai/vite-plugin-yet-another-svg-sprites",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "peerDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "svgo": "^4.1.0",
    "svgstore": "^3.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
